# Dependencies
node_modules/
**/node_modules/
dist/
**/dist/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
**/secrets/**

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Test / coverage
coverage/
.vitest/

# Local runtime scratch (Phase 1 — not durable SoT)
.runtime/
.tmp/
*.local.json

# Wave 3 local ops data plane (file-backed store)
data/ops/*.json
data/ops/*.tmp
!data/ops/.gitkeep

# Wave 4 asset metadata catalog (binaries never in Git)
data/assets/*.json
data/assets/*.tmp
!data/assets/.gitkeep

# Wave 4b Figma arrange jobs (pointers only)
data/figma/*.json
data/figma/*.tmp
!data/figma/.gitkeep

# Wave 4b Higgsfield generate jobs (pointers only)
data/higgsfield/*.json
data/higgsfield/*.tmp
!data/higgsfield/.gitkeep

# Wave 4b video produce jobs (export packages / recipes only)
data/video/*.json
data/video/*.tmp
!data/video/.gitkeep

# Generated onboarding reports (optional local)
# reports/ is committed for Phase 2 gap snapshot — keep JSON only

# Large marketing assets (never commit binaries)
assets/binaries/
**/*.mp4
**/*.mov
**/*.psd
**/*.ai

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
