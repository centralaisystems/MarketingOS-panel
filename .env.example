# Marketing OS — environment variable names only.
# Copy to .env.local and fill values. Never commit secrets.
# Phase 1: no production integrations are wired.

# Future Supabase (Phase 4+). Wave 3 panel defaults to file/memory.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Wave 3 operator panel
# PANEL_PORT=8787
# MOS_OPS_DIR=data/ops
# MOS_OPS_BACKEND=file
# MOS_PANEL_WRITE_REPORT=true

# Future model providers (configurable; not hardcoded)
# MODEL_PROVIDER=
# MODEL_API_KEY_FAST=
# MODEL_API_KEY_GENERAL=
# MODEL_API_KEY_REASONING=

# Future object storage
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# Wave 4 asset metadata catalog (binaries stay out of Git)
# MOS_ASSETS_DIR=data/assets
# MOS_ASSETS_SEED=true

# Wave 4b Drive ingest — fixture is default; live Drive is optional and read-only.
# MOS_DRIVE_SOURCE=fixture
# MOS_DRIVE_ACCESS_TOKEN=

# Wave 4b Figma arrange — fixture is default; live Figma is optional.
# MOS_FIGMA_SOURCE=fixture
# MOS_FIGMA_ACCESS_TOKEN=
# MOS_FIGMA_FILE_KEY=
# MOS_FIGMA_DIR=data/figma

# Wave 4b Higgsfield fill-gaps — fixture is default; live Higgsfield is optional.
# MOS_HIGGSFIELD_SOURCE=fixture
# MOS_HIGGSFIELD_API_KEY=
# MOS_HIGGSFIELD_API_BASE=
# MOS_HIGGSFIELD_DIR=data/higgsfield

# Wave 4b video export packages — fixture is default.
# capcut / adobe_premiere are labeled stubs that emit the same recipe.
# They do not require CapCut or Adobe installed and do not control desktop apps.
# MOS_VIDEO_SOURCE=fixture
# MOS_VIDEO_DIR=data/video

# Future analytics (read-only). Wave 4 uses fixture adapters; do not grant write scopes.
# GA4_PROPERTY_ID=
# GSC_SITE_URL=

# Future advertising (Phase 7 — write disabled by default)
# META_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# Wave 5 social publish — dry-run is the default. Never set live true here
# unless an operator has explicitly enabled live_publish_allowed in PHASE_GATES.
# MOS_LIVE_PUBLISH=false

# Owner review emails — dry_run is the default (writes audit/outbox only).
# MOS_EMAIL_MODE=dry_run
# MOS_EMAIL_MODE=resend
# MOS_EMAIL_FROM=
# MOS_PANEL_BASE_URL=http://127.0.0.1:8787
# RESEND_API_KEY=

# Runtime
MARKETING_OS_PHASE=1
MARKETING_OS_ALLOW_EXTERNAL_WRITES=false
