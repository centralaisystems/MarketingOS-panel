# Marketing OS — environment variable names only.
# Copy to .env.local and fill values. Never commit secrets.
# Phase 1: no production integrations are wired.

# Optional Supabase ops store (MOS_OPS_STORE=supabase). Not required for pnpm test.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Wave 3 operator panel (honest Node HTTP — PORT for hosts/containers)
# PORT=8787
# PANEL_PORT=8787
# HOST=0.0.0.0
# MOS_PANEL_HOST=0.0.0.0
# MOS_OPS_DIR=data/ops
# MOS_OPS_STORE=file
# MOS_OPS_BACKEND=file
# MOS_PANEL_WRITE_REPORT=true

# Optional registry overlay when REGISTRY.local.json is not on the host (Railway).
# Same shape as brands/_shared/REGISTRY.local.json.example. Never commit real inboxes.
# MOS_REGISTRY_LOCAL_JSON={"brands":[{"brand_id":"VILLA_GLORY","owner_email":"owner@example.test","owner_cc":["cc@example.test"],"asset_drive_folder_id":"YOUR_FOLDER_ID","asset_drive_folder_url":"https://drive.google.com/drive/folders/YOUR_FOLDER_ID"}]}
# Or per-brand convenience (same overlay; JSON wins on overlap):
# MOS_OWNER_EMAIL_VILLA_GLORY=
# MOS_OWNER_CC_VILLA_GLORY=
# MOS_DRIVE_FOLDER_URL_VILLA_GLORY=
# MOS_DRIVE_FOLDER_ID_VILLA_GLORY=

# Future model providers (configurable; not hardcoded)
# MODEL_PROVIDER=
# MODEL_API_KEY_FAST=
# MODEL_API_KEY_GENERAL=
# MODEL_API_KEY_REASONING=

# Future object storage
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# Wave 4 asset metadata catalog (binaries stay out of Git)
# MOS_ASSETS_DIR=data/assets
# MOS_ASSETS_SEED=true
# Follows MOS_OPS_STORE unless set. Railway supabase ops must use supabase here
# (or leave unset) so Drive ingest survives redeploy.
# MOS_ASSETS_STORE=file
# MOS_DRIVE_BOOT_SYNC=true
# MOS_DRIVE_BOOT_SYNC_BRANDS=VILLA_GLORY

# Wave 4b Drive ingest — fixture is default; live Drive is optional and read-only.
# MOS_DRIVE_SOURCE=fixture
# MOS_DRIVE_SOURCE=google_drive
# Preferred for Railway / long-running panel: GCP service account JSON.
# Share each brand folder with the SA client_email as Viewer (read-only).
# Never commit the JSON or private key. Railway: set the full JSON as a secret.
# MOS_DRIVE_SERVICE_ACCOUNT_JSON=
# MOS_DRIVE_SERVICE_ACCOUNT_FILE=
# Local/dev fallback — short-lived user OAuth Bearer (~1h). Not suitable for Railway.
# MOS_DRIVE_ACCESS_TOKEN=

# Wave 4b Figma arrange — fixture is default; live Figma is optional.
# MOS_FIGMA_SOURCE=fixture
# MOS_FIGMA_ACCESS_TOKEN=
# MOS_FIGMA_FILE_KEY=
# MOS_FIGMA_DIR=data/figma

# Wave 4b Higgsfield fill-gaps — fixture is default; live Higgsfield is optional.
# MOS_HIGGSFIELD_SOURCE=fixture
# MOS_HIGGSFIELD_API_KEY=
# MOS_HIGGSFIELD_API_BASE=
# MOS_HIGGSFIELD_DIR=data/higgsfield

# Wave 4b video export packages — fixture is default.
# capcut / adobe_premiere are labeled stubs that emit the same recipe.
# They do not require CapCut or Adobe installed and do not control desktop apps.
# MOS_VIDEO_SOURCE=fixture
# MOS_VIDEO_DIR=data/video

# Future analytics (read-only). Wave 4 uses fixture adapters; do not grant write scopes.
# GA4_PROPERTY_ID=
# GSC_SITE_URL=

# Wave 6 paid ads — staging is the default. Never set live true here
# unless an operator has explicitly enabled live_ads_allowed in PHASE_GATES.
# MOS_LIVE_ADS=false
# MOS_ADS_SOURCE=fixture
# MOS_ADS_SOURCE=meta_api
# MOS_ADS_SOURCE=google_ads
# Names only — research agent never receives these values.
# META_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# Wave 5 social publish — dry-run is the default. Never set live true here
# unless an operator has explicitly enabled live_publish_allowed in PHASE_GATES.
# MOS_LIVE_PUBLISH=false

# Owner review emails — dry_run is the default (writes audit/outbox only).
# MOS_EMAIL_MODE=dry_run
# MOS_EMAIL_MODE=resend
# MOS_EMAIL_FROM=
# MOS_PANEL_BASE_URL=http://127.0.0.1:8787
# RESEND_API_KEY=

# Wave 8 automation digests use the same email adapter (dry-run default).
# Per-brand kill switch is registry automation_enabled (Villa Glory fixture on).
# Emailing also requires owner_email_enabled. No production cron is shipped.
# pnpm run-digest -- --brand VILLA_GLORY --period daily

# Runtime
MARKETING_OS_PHASE=1
MARKETING_OS_ALLOW_EXTERNAL_WRITES=false
